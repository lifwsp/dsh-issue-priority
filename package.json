{
  "name": "dsh-work-planner",
  "version": "0.7.0",
  "description": "Work planner for DeepSeek Harness: groups GitHub issues into session-sized work packages, orders them by dependencies, importance and urgency, and hands the next package to the coding agent. Reads GitHub issue fields, sub-issues and dependencies; plans stay local.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "issues",
    "planning",
    "liquid-d1",
    "decision-model",
    "better-sidebar"
  ],
  "license": "MIT",
  "author": "lifwsp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lifwsp/dsh-work-planner.git"
  },
  "homepage": "https://github.com/lifwsp/dsh-work-planner#readme",
  "bugs": {
    "url": "https://github.com/lifwsp/dsh-work-planner/issues"
  },
  "type": "module",
  "engines": {
    "dsh": ">=0.1.7",
    "node": "^22.19.0 || >=24"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-better-sidebar"
      ]
    }
  },
  "files": [
    "dist",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./client/client.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.7 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
